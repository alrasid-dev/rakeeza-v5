# ============================================================
# Rakeza (ركيزة) — Environment Variables
# انسخ هذا الملف إلى `.env.local` للتطوير المحلي، وأضف نفس القيم في Vercel.
# ============================================================

# --- قاعدة البيانات: Turso (libSQL) — دائمة للإنتاج ---
# أنشئ قاعدة من Turso ثم ضع الرابط والتوكن هنا وفي Vercel.
TURSO_DATABASE_URL="libsql://<your-database>-rakeeza.turso.io"
TURSO_AUTH_TOKEN="<your-turso-auth-token>"

# --- بديل محلي (تطوير فقط — SQLite في مجلد data) ---
# لا تضع هذا في Vercel؛ يُستخدم فقط عند التشغيل المحلي بدون Turso.
DATABASE_URL="file:../data/rakeeza.db"

# --- جلسة الدخول (اختياري؛ الافتراضي dev-secret) ---
AUTH_SECRET="change-me-to-a-long-random-string"

# --- مفتاح عام للواجهة (إن وُجد) ---
PUBLIC_API_KEY="change-me-public-api-key"

# --- الذكاء الاصطناعي: المحلل الدلالي الموحد (OpenRouter) ---
DEEPSEEK_API_KEY="sk-or-v1-..."

# Optional — if unset, AI assist uses local heuristics
# OPENAI_API_KEY=

